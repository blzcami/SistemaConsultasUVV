@model SistemaConsultasUVV.Models.Consulta

@{
    ViewData["Title"] = "Nova Consulta";
}

<h1>Nova Consulta</h1>

<hr />

<form asp-action="Criar" method="post">

    <div class="mb-3">
        <label asp-for="Especialidade" class="form-label">
            Especialidade
        </label>

        <input asp-for="Especialidade"
               class="form-control"
               placeholder="Ex.: Cardiologia" />

        <span asp-validation-for="Especialidade"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="DataHora" class="form-label">
            Data e Hora
        </label>

        <input asp-for="DataHora"
               type="datetime-local"
               class="form-control" />

        <span asp-validation-for="DataHora"
              class="text-danger">
        </span>
    </div>

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label">
            Descrição
        </label>

        <textarea asp-for="Descricao"
                  class="form-control"
                  rows="4"
                  placeholder="Informe detalhes sobre a consulta...">
        </textarea>

        <span asp-validation-for="Descricao"
              class="text-danger">
        </span>
    </div>

    <button type="submit" class="btn btn-primary">
        Cadastrar Consulta
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Voltar
    </a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}